  "engines": {
    "node": ">=22"
  },
  "description": "Расчёты Sky Guide для Hypixel SkyBlock: разбор профиля, план, рынок, гайды, переводы",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sky-guide-ru/core.git"
  },
